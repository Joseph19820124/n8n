# n8n Docker 部署环境变量配置
# 复制此文件为 .env 并修改相应的值

# ==========================================
# 数据库配置
# ==========================================
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your_secure_password_here
DB_POSTGRESDB_PASSWORD=your_secure_password_here

# ==========================================
# 安全配置 (必须修改!)
# ==========================================
# 32字符的加密密钥 (可使用: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=change_me_to_32_character_string_here_12345678

# JWT密钥 (可使用: openssl rand -hex 32)
N8N_USER_MANAGEMENT_JWT_SECRET=change_me_to_32_character_jwt_secret_here_1234

# ==========================================
# 基础认证 (初始设置时使用)
# ==========================================
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_admin_password

# ==========================================
# n8n 配置
# ==========================================
# 访问URL (修改为你的域名或IP)
WEBHOOK_URL=http://localhost:5678/
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http

# ==========================================
# 时区设置
# ==========================================
GENERIC_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# ==========================================
# 执行设置
# ==========================================
EXECUTIONS_MODE=queue
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=true
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# ==========================================
# 性能设置
# ==========================================
# Node.js 内存限制 (MB)
NODE_MAX_OLD_SPACE_SIZE=2048
N8N_CONCURRENCY_PRODUCTION_LIMIT=10

# ==========================================
# 日志设置
# ==========================================
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# ==========================================
# 自定义节点设置
# ==========================================
NODE_FUNCTION_ALLOW_EXTERNAL=*
NODE_FUNCTION_ALLOW_BUILTIN=*

# ==========================================
# SMTP 邮件配置 (可选)
# ==========================================
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.gmail.com
# N8N_SMTP_PORT=465
# N8N_SMTP_USER=your-email@gmail.com
# N8N_SMTP_PASS=your-app-password
# N8N_SMTP_SENDER=your-email@gmail.com
# N8N_SMTP_SSL=true

# ==========================================
# 外部服务集成 (可选)
# ==========================================
# N8N_SENTRY_DSN=
# N8N_DIAGNOSTICS_ENABLED=false